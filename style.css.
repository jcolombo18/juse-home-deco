
/* ESTILOS GENERALES */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: auto;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f7f4ef;
    color: #51483f;
}

/* ENCABEZADO */
header {
    background-color: #e8dfd2;
    text-align: center;
    padding: 35px 20px;
}

header h1 {
    font-size: 30px;
    letter-spacing: 4px;
    color: #5c5045;
}

header p {
    margin-top: 10px;
    font-size: 14px;
    letter-spacing: 2px;
}

/* MENU DE NAVEGACION */
nav {
    background-color: #8b7967;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 30px;
    padding: 18px;
}

nav a {
    color: white;
    text-decoration: none;
    font-size: 14px;
}

nav a:hover {
    color: #eadfce;
}

/* CONTENIDO PRINCIPAL */
main {
    max-width: 1100px;
    margin: 50px auto;
    padding: 20px;
    text-align: center;
}

main h2 {
    font-size: 28px;
    margin-bottom: 15px;
}

main > p {
    color: #81766b;
    margin-bottom: 40px;
}

/* PANELES */
.paneles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
}

.panel {
    background-color: #ffffff;
    padding: 35px 20px;
    border-radius: 10px;
    border: 1px solid #e4dbcf;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
}

.panel h3 {
    margin-bottom: 15px;
    color: #796653;
}

.panel p {
    font-size: 14px;
    color: #81766b;
    line-height: 1.5;
}

/* SECCIONES */
.seccion {
    max-width: 1100px;
    margin: 40px auto;
    padding: 30px 20px;
    background-color: white;
    border-radius: 10px;
    border: 1px solid #e4dbcf;
}

.seccion h2 {
    color: #796653;
    margin-bottom: 15px;
}

.seccion > p {
    margin-bottom: 25px;
    color: #81766b;
}

/* FORMULARIO */
#product-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px;
    margin-bottom: 35px;
}

#product-form input,
#product-form select {
    width: 100%;
    padding: 12px;
    border: 1px solid #d8cbbd;
    border-radius: 6px;
    font-size: 14px;
}

#product-form button {
    background-color: #8b7967;
    color: white;
    border: none;
    padding: 13px;
    border-radius: 6px;
    cursor: pointer;
}

#product-form button:hover {
    background-color: #6f5d4d;
}

/* TABLA DE PRODUCTOS */
.tabla-contenedor {
    width: 100%;
    overflow-x: auto;
    margin-top: 20px;
}

table {
    width: 100%;
    border-collapse: collapse;
    background-color: white;
}

th,
td {
    padding: 12px;
    border: 1px solid #e4dbcf;
    text-align: left;
}

th {
    background-color: #e8dfd2;
    color: #5c5045;
}

/* BOTONES DE ACCIONES */
td button {
    padding: 8px 12px;
    margin: 3px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

td button:first-child {
    background-color: #8b7967;
    color: white;
}

td button:last-child {
    background-color: #b87568;
    color: white;
}

/* PIE DE PAGINA */
footer {
    background-color: #e8dfd2;
    text-align: center;
    padding: 20px;
    margin-top: 60px;
    font-size: 13px;
}

/* ADAPTACION A CELULARES */
@media (max-width: 600px) {
    nav {
        gap: 15px;
    }

    .seccion {
        margin: 25px 10px;
        padding: 20px 12px;
    }

    table {
        min-width: 650px;
    }
}
