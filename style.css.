/* ESTILOS GENERALES /
{
margin: 0;
padding: 0;
box-sizing: border-box;
}
body {
font-family: Arial, sans-serif;
background-color: #f7f4ef;
color: #51483f;
}
/* ENCABEZADO /
header {
background-color: #e8dfd2;
text-align: center;
padding: 35px 20px;
}
header h1 {
font-size: 30px;
letter-spacing: 4px;
color: #5c5045;
}
header p {
margin-top: 10px;
font-size: 14px;
letter-spacing: 2px;
}
/* MENU DE NAVEGACION /
nav {
background-color: #8b7967;
display: flex;
justify-content: center;
flex-wrap: wrap;
gap: 30px;
padding: 18px;
}
nav a {
color: white;
text-decoration: none;
font-size: 14px;
}
nav a:hover {
color: #eadfce;
}
/* CONTENIDO PRINCIPAL /
main {
max-width: 1100px;
margin: 50px auto;
padding: 20px;
text-align: center;
}
main h2 {
font-size: 28px;
margin-bottom: 15px;
}
main > p {
color: #81766b;
margin-bottom: 40px;
}
/* PANELES /
.paneles {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
gap: 20px;
}
.panel {
background-color: #ffffff;
padding: 35px 20px;
border-radius: 10px;
border: 1px solid #e4dbcf;
box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
}
.panel h3 {
margin-bottom: 15px;
color: #796653;
}
.panel p {
font-size: 14px;
color: #81766b;
line-height: 1.5;
}
/* PIE DE PAGINA /
footer {
background-color: #e8dfd2;
text-align: center;
padding: 20px;
margin-top: 60px;
font-size: 13px;
}
